# MinIO OSS: бинарники больше не раздаются с dl.min.io (410 Gone) и образ
# minio/minio удалён из Docker Hub, поэтому образ собирается из последнего
# опубликованного OSS-релиза на GitHub.
FROM alpine:3.21

ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
ARG TARGETARCH=amd64

RUN apk add --no-cache ca-certificates curl \
 && curl -fsSL -o /usr/local/bin/minio \
      "https://github.com/minio/minio/releases/download/${MINIO_RELEASE}/minio.linux-${TARGETARCH}.${MINIO_RELEASE}" \
 && chmod +x /usr/local/bin/minio \
 && mkdir -p /data \
 && /usr/local/bin/minio --version

EXPOSE 9000 9001

ENTRYPOINT ["/usr/local/bin/minio"]
