# Параметры приложения
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOGS_PATH=logs
# Каталог собранного фронтенда (в контейнере переопределяется на /app/static)
SPA_DIR=web/dist
# Дополнительные origin для CORS через запятую (нужно только для vite dev-сервера)
CORS_ORIGINS=

# PostgreSQL
POSTGRES_USER=storage
POSTGRES_PASSWORD=storage_secret
POSTGRES_DB=storage
# Внутри docker-сети переопределяется на postgres (см. docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Необязательно: полный DSN, имеет приоритет над POSTGRES_*
# DB_URL=postgresql+asyncpg://storage:storage_secret@localhost:5432/storage

# JWT и cookie
# openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_HOURS=48
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# MinIO (учётные данные используются и контейнером MinIO, и сервисом)
MINIO_ENDPOINT=localhost:9000
# Внутри docker-сети переопределяется на minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Квоты
DEFAULT_QUOTA_BYTES=2147483648
MAX_UPLOAD_SIZE_BYTES=5368709120
