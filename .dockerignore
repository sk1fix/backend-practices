# Контекст сборки: всё, что не нужно внутри образа, не должно уезжать в демон.
# Без этого файла в сборку попадают .venv (~93 МиБ) и web/node_modules (~70 МиБ).

# Служебное репозитория
.git
.gitignore
.dockerignore

# Локальные окружения и кэши
.venv
venv
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Фронтенд пересобирается внутри образа (стадия web-build)
web/node_modules
web/dist

# Данные и логи монтируются из хоста, в образе им делать нечего
data
logs

# Секреты и локальные файлы
.env
.verify/
.vscode/
.idea/
